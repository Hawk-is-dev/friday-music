# --- Friday Music Sample Environment Variables ---
# Copy this file to .env and fill in the values

# Core Telegram API (Get from https://my.telegram.org)
API_ID=
API_HASH=

# Bot Token (Get from @BotFather on Telegram)
BOT_TOKEN=

# MongoDB Database (Get from https://mongodb.com)
# Used for saving User IDs for broadcasting.
MONGO_DB_URI=

# Redis Database (Optional, for caching)
REDIS_URL=
REDIS_TOKEN=

# Assistant Session String (Generate using a session string generator)
# Required for assistant to play songs on voice chat.
STRING_SESSION=

# Internal IDs
OWNER_ID=      # Your Telegram User ID
LOGGER_ID=     # Your Telegram Chat ID For logs (Bot and Assistant should be Admins!)
POST_CHANNEL_ID=

# Optional Variables
UPDATES_CHANNEL= # Public Channel Username (e.g., FridaySupport) for force join.

# AI & Other APIs
GROQ_API_KEY=
API_KEY=
API_URL=
VERCEL_SEARCH_URL=
LASTFM_API_KEY=

# YouTube cookies (optional but recommended on servers). Paste the FULL Netscape cookies.txt text,
# or put a base64 of the file in COOKIES_B64. Never commit cookies.txt to GitHub.
COOKIES_TEXT=
COOKIES_B64=
