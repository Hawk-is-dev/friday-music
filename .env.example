# Required Telegram credentials
BOT_TOKEN=
API_ID=
API_HASH=

# Sanya-compatible assistant session variable.
# Leave empty only if setting up the session with /gensession.
STRING_SESSION=
# Legacy alias (used only when STRING_SESSION is empty):
SESSION_STRING=

# Welcome panel (same variable names as Sanya)
BOT_NAME=FRIDAY
START_IMG_URL=https://files.catbox.moe/3sbjl5.jpg
SUPPORT_CHANNEL=@eternalsportal
SUPPORT_CHAT=@genzportals

# Track duration limit in minutes (default: 30; maximum: 240)
DURATION_LIMIT=30

# Optional YouTube cookies, only if the extractor requests them
# COOKIES_B64=base64-encoded Netscape cookies.txt
# COOKIES_PATH=/absolute/path/to/cookies.txt

# Runtime settings
DOWNLOAD_DIR=downloads
LOG_LEVEL=info
