# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# Required user/assistant account session for joining group voice chats.
# Keep private. Never commit a real session string.
SESSION_STRING=

# Optional YouTube authentication cookies (choose one; keep secret).
# COOKIES_B64=base64-encoded Netscape cookies.txt
# COOKIES_PATH=/absolute/path/to/cookies.txt

# Optional
DOWNLOAD_DIR=downloads
LOG_LEVEL=info
# Maximum external media duration in minutes (default 30; valid range 1-240)
MAX_DURATION_MINUTES=30
