# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# Optional on first startup. Use /gensession in the owner's private chat to create it.
# After generation, copy it into Railway Variables and redeploy. Keep private.
SESSION_STRING=

# Your Telegram numeric user ID; required to authorize /gensession commands.
OWNER_ID=

# Optional YouTube authentication cookies (choose one; keep secret).
# COOKIES_B64=base64-encoded Netscape cookies.txt
# COOKIES_PATH=/absolute/path/to/cookies.txt

# Optional
DOWNLOAD_DIR=downloads
LOG_LEVEL=info
# Maximum external media duration in minutes (default 30; valid range 1-240)
MAX_DURATION_MINUTES=30
